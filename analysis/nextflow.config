/*
 * nextflow.config — MalaCall (pan-Plasmodium) analysis pipeline
 */
manifest {
    name        = 'malacall'
    description = 'MalaCall — end-to-end pan-Plasmodium amplicon analysis & reporting (6 taxa, resistance, CNV/deletions, diversity, Pk cluster, cohort COI & relatedness)'
    version     = '1.0.0'
    mainScript  = 'main.nf'
    nextflowVersion = '>=23.04'
}

params {
    // interpreter that has pysam / numpy / pandas (edit to your env, or use the conda profile)
    python = 'python3'
}

process {
    cpus   = 4
    memory = '6 GB'
    errorStrategy = 'retry'
    maxRetries    = 1
    withName: MAP { cpus = 4; memory = '8 GB' }
}

profiles {
    standard { process.executor = 'local' }

    // Point `python` at an interpreter that already has pysam/numpy/pandas. `localpy` is the documented default —
    // edit its path to your own env (e.g. the `panplasmo` env from the manual). On another machine you can instead
    // use `-profile conda`/`docker`, or `--python /path/to/your/env/bin/python3`.
    localpy      { params.python = 'python3' }   // edit to your env, or let `malacall run` inject it
    // `captureforge` = retained alias for `localpy` (same interpreter). It is NOT a dependency on the CaptureForge
    // software — just the name of the dev-machine conda env, first created for the panel-DESIGN work and reused here.
    captureforge { params.python = 'python3' }   // retained alias

    // sequencing chemistry
    ont      { params.platform = 'ont' }
    illumina { params.platform = 'illumina' }

    // container / conda options (fill in for your infra)
    conda    { conda.enabled = true; process.conda = "${projectDir}/environment.yml" }
    docker   { docker.enabled = true; process.container = 'quay.io/biocontainers/mulled-v2-minimap2-samtools-pysam' }

    // built-in smoke test on simulated data (see test/)
    test {
        params.samplesheet = "${projectDir}/test/samples.csv"
        params.python      = 'python3'
        params.outdir      = 'results_test'
    }
}

// provenance & DAG
report   { enabled = true; file = "${params.outdir}/pipeline_report.html"; overwrite = true }
timeline { enabled = true; file = "${params.outdir}/pipeline_timeline.html"; overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_dag.html"; overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_trace.txt"; overwrite = true }
