# ── Secrets / credentials (never commit) ───────────────────────────────
.env
.env.*
*.pem
*.key
*_key
*_secret*
*credential*
*.p12
id_rsa*

# ── Nextflow run artifacts (regenerable; embed absolute machine paths) ──
.nextflow/
.nextflow.log*
**/work/
analysis/results/
analysis/results_*/
**/.nextflow*
timeline*.html
trace*.txt

# ── Dev scratch (one-off scripts, logs; contain machine/cross-project paths) ──
scratch/
**/scratch/
*.log

# ── Generated test data & outputs (recreate with `malacall validate`) ──
analysis/test/sim/
analysis/test/out/
analysis/test/demux/
analysis/test/runsim/
analysis/manifest/*.fa
analysis/manifest/*.bed

# ── Generated document intermediates (source is the .md / .html) ───────
analysis/MANUAL.html
docs/.sf_light.html
**/*.sf_light.html


# ── Raw reference genomes (~250 MB; re-download with `malaforge fetch-refs`) ──
#    Analysis only needs the committed refs/pan_reference.fa.gz; these are design-only.
refs/nuclear/
refs/anno/


# ── Proposal / panel IP — kept LOCAL, never committed (primer sequences, panel
