design/panel_tailed.tsv
design/panel_pools.tsv
design/panel_qc_dimers.tsv
design/module_*.tsv
analysis/manifest/amplicons.tsv
analysis/manifest/amplicons.paf
analysis/refs/pk_diag_panel.tsv
